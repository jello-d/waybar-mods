+static const unsigned RECONNECT_SECONDS = 5;
+
+Watcher::Watcher(const std::string& address)
+    : address_(address), watcher_(sn_watcher_skeleton_new()) {
+  if (address_.empty()) {
+    bus_name_id_ =
+        Gio::DBus::own_name(Gio::DBus::BusType::BUS_TYPE_SESSION, "org.kde.StatusNotifierWatcher",
+                            sigc::mem_fun(*this, &Watcher::busAcquired),
+                            Gio::DBus::SlotNameAcquired(), Gio::DBus::SlotNameLost(),
+                            Gio::DBus::BUS_NAME_OWNER_FLAGS_ALLOW_REPLACEMENT |
+                                Gio::DBus::BUS_NAME_OWNER_FLAGS_REPLACE);
+    return;
+  }
+  connect();
+}
+
+// A tray on another bus (a filtering proxy into an enclave's session bus) may
+// find it absent, or lose it, at any time. Neither may take the bar down: the
+// tray stays empty and the watcher retries until the bus is back.
+void Watcher::connect() {
+  cancellable_ = Gio::Cancellable::create();
+  Gio::DBus::Connection::create_for_address(address_, sigc::mem_fun(*this, &Watcher::connected),
+                                            cancellable_,
+                                            Gio::DBus::CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                                                Gio::DBus::CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION);
+}
+
+void Watcher::connected(Glib::RefPtr<Gio::AsyncResult>& result) {
+  try {
+    conn_ = Gio::DBus::Connection::create_for_address_finish(result);
+  } catch (const Glib::Error& err) {
+    if (!connect_failed_) {
+      spdlog::warn("Tray: bus {} unreachable ({}); retrying every {}s", address_,
+                   err.what().c_str(), RECONNECT_SECONDS);
+      connect_failed_ = true;
+    }
+    retry_ = Glib::signal_timeout().connect_seconds(sigc::mem_fun(*this, &Watcher::retry),
+                                                    RECONNECT_SECONDS);
+    return;
+  }
+  spdlog::info("Tray: hosting items on {}", address_);
+  connect_failed_ = false;
+  // g_dbus_connection_new_for_address() already leaves this false; said
+  // explicitly because exiting on close would take the whole bar with it.
+  conn_->set_exit_on_close(false);
+  conn_->signal_closed().connect(sigc::mem_fun(*this, &Watcher::disconnected));
+  busAcquired(conn_, "");
+  bus_name_id_ = g_bus_own_name_on_connection(
+      conn_->gobj(), "org.kde.StatusNotifierWatcher",
+      static_cast<GBusNameOwnerFlags>(G_BUS_NAME_OWNER_FLAGS_ALLOW_REPLACEMENT |
+                                      G_BUS_NAME_OWNER_FLAGS_REPLACE),
+      nullptr, nullptr, nullptr, nullptr);
+  signal_connection.emit(conn_);
+}
+
+void Watcher::disconnected(bool /*remote_peer_vanished*/, const Glib::Error& /*error*/) {
+  spdlog::warn("Tray: lost bus {}; retrying every {}s", address_, RECONNECT_SECONDS);
+  // Hosts drop their items first, while the watches they mirror still exist.
