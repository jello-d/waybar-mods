+    g_bus_unown_name(bus_name_id_);
+    bus_name_id_ = 0;
+  }
+  g_dbus_interface_skeleton_unexport(G_DBUS_INTERFACE_SKELETON(watcher_));
+  g_slist_free_full(hosts_, gfWatchFree);
+  hosts_ = nullptr;
+  g_slist_free_full(items_, gfWatchFree);
+  items_ = nullptr;
+  updateRegisteredItems(watcher_);
+  sn_watcher_set_is_host_registered(watcher_, FALSE);
+  conn_.reset();
+  connect_failed_ = true;
+  retry_ = Glib::signal_timeout().connect_seconds(sigc::mem_fun(*this, &Watcher::retry),
+                                                  RECONNECT_SECONDS);
+}
+
+bool Watcher::retry() {
+  connect();
+  return false;
+}
 
