+// Re-fetch all properties (over the well-known bus_name; see getUpdatedProperties)
+// until id/category arrive, bounded. Needed when an item's proxy cache came back
+// empty at registration. Well-known addressing succeeds immediately for a healthy
+// item, so this normally converges on the first attempt; the retry only covers an
+// item whose object is genuinely not ready yet. After the window is exhausted the
+// item is declared invalid.
+void Item::scheduleRefetch() {
+  static const unsigned kMaxRefetchTries = 20;   // ~10s at 500ms
+  static const unsigned kRefetchDelayMs = 500;
+  if (!id.empty() && !category.empty()) return;  // already resolved
+  if (refetch_tries_ >= kMaxRefetchTries) {
+    spdlog::error("Invalid Status Notifier Item: {}, {}", bus_name, object_path);
+    return;
+  }
+  ++refetch_tries_;
+  for (std::string_view prop :
+       {"Category", "Id", "Title", "Status", "IconName", "IconPixmap",
+        "IconThemePath", "OverlayIconName", "AttentionIconName", "ToolTip",
+        "Menu", "ItemIsMenu"}) {
+    update_pending_.insert(prop);
+  }
+  Glib::signal_timeout().connect_once(sigc::mem_fun(*this, &Item::getUpdatedProperties),
+                                      kRefetchDelayMs);
+}
