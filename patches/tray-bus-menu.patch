+// Build the menu from the item's layout and pop it up, inside the press (see
+// bus_menu::fetch for why both). False when there is nothing to show.
+bool Item::openBusMenu(GdkEventButton* ev) {
+  auto* conn = proxy_->get_connection()->gobj();
+  GVariant* children = bus_menu::fetch(conn, bus_name, menu);
+  if (children == nullptr) {
+    return false;
+  }
+  bus_menu_ = std::make_unique<Gtk::Menu>();
+  bus_menu::fill(*bus_menu_, children, conn, bus_name, menu);
+  g_variant_unref(children);
+  bus_menu_->attach_to_widget(event_box);
+  bus_menu_->popup_at_pointer(reinterpret_cast<GdkEvent*>(ev));
+  event_box.unset_state_flags(Gtk::StateFlags::STATE_FLAG_PRELIGHT);
+  return true;
+}
