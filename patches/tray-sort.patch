+// Order the tray's items by the "order" config (a list of SNI ids/titles),
+// then alphabetically for anything unlisted -- a stable, config-driven order
+// (SNI items otherwise appear in nondeterministic registration order).
+void Tray::sortItems() {
+  const auto& order = config_["order"];
+  auto rank = [&order](const Item* it) -> int {
+    if (order.isArray()) {
+      for (int i = 0; i < static_cast<int>(order.size()); ++i) {
+        const std::string key = order[i].asString();
+        if (it->id == key || it->title == key) return i;
+      }
+      return static_cast<int>(order.size());
+    }
+    return 0;
+  };
+  std::vector<Item*> sorted = items_;
+  std::stable_sort(sorted.begin(), sorted.end(), [&rank](const Item* a, const Item* b) {
+    const int ra = rank(a), rb = rank(b);
+    if (ra != rb) return ra < rb;
+    const std::string& ka = a->id.empty() ? a->title : a->id;
+    const std::string& kb = b->id.empty() ? b->title : b->id;
+    return ka < kb;
+  });
+  const bool rev =
+      config_["reverse-direction"].isBool() && config_["reverse-direction"].asBool();
+  const int n = static_cast<int>(sorted.size());
+  for (int i = 0; i < n; ++i) {
+    box_.reorder_child(sorted[i]->event_box, rev ? n - 1 - i : i);
+  }
+}
