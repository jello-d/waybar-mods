#!/bin/sh
# test/run - run every waybar-mods shell test (test/*.t) and report. Non-zero if
# any fails. POSIX sh, no dependency beyond a shell + the repo checkout. These
# are FAST static tests (recipe integrity, dispatch, the audit path); the REAL
# build validation is `setup.sh verify`, which compiles against the pinned
# upstream and is deliberately NOT in this suite (heavy + network).
#
# SKIPS ARE COUNTED AND PRINTED: a test that cannot run here prints `skip ...`
# as its last line and is counted, so a green run never silently omits coverage.
set -eu
_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

_rc=0
_pass=0
_skip=0
for _t in "$_dir"/*.t; do
  [ -f "$_t" ] || continue
  _out=$(sh "$_t" 2>&1) || _rc=1
  printf '%s\n' "$_out"
  case "$(printf '%s\n' "$_out" | tail -n 1)" in
    skip\ *) _skip=$((_skip + 1)) ;;
    ok\ *)   _pass=$((_pass + 1)) ;;
  esac
done

if [ "$_rc" -ne 0 ]; then
  echo "waybar-mods tests FAILED"
  exit 1
fi
if [ "$_skip" -gt 0 ]; then
  printf 'all waybar-mods tests passed (%d ok, %d skipped)\n' "$_pass" "$_skip"
else
  printf 'all waybar-mods tests passed (%d)\n' "$_pass"
fi
exit 0
